{
  "name": "filesense",
  "private": true,
  "version": "1.0.0",
  "description": "Smart Local File Organizer & Cryptographic SHA-256 Duplicate Cleaner",
  "main": "server.ts",
  "bin": {
    "filesense": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "node dist/server.js",
    "cli": "tsx bin/filesense.ts",
    "server": "tsx server/index.ts",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --outfile=dist/server.js --external:express --external:@google/genai --external:dotenv --external:vite --format=esm",
    "build:cli": "esbuild bin/filesense.ts --bundle --platform=node --target=node20 --outfile=dist/cli.js --external:@google/genai --external:dotenv --format=esm",
    "build": "npm run build:client && npm run build:server && npm run build:cli",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "idb": "^8.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.13",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
